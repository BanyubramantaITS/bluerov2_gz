<?xml version="1.0"?>
<robot name="bluerov2_heavy" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link">
    <visual>
      <origin />
      <geometry>
        <mesh filename="package://bluerov2_gz/models/bluerov2_heavy/meshes/bluerov2_heavy.dae"
          scale="0.025 0.025 0.025" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" />
      <geometry>
        <box size="0.457 0.575 0.05" />
      </geometry>
    </collision>
  </link>

  <link name="dummy_base_link">
    <inertial>
      <origin xyz="0 0 0.011" />
      <mass value="13.0" />
      <inertia ixx="0.26" iyy="0.23" izz="0.37" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>

  <joint name="dummy_joint" type="fixed">
    <parent link="base_link" />
    <child link="dummy_base_link" />
  </joint>


  <link name="front_camera_link">
  </link>

  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_camera_link" />
    <origin xyz="0.093 0.001 0.063" rpy="0 0 0" />
  </joint>

  <gazebo reference="base_link">
    <!-- IMU sensor gyro and accel data will be sent to ArduSub -->
    <sensor name="imu_sensor" type="imu">
      <!-- Transform from the Gazebo body frame (x-forward, y-left, z-up)
           to the ArduPilot body frame (x-forward, y-right, z-down) -->
      <pose>0 0 0 3.142 0 0</pose>
      <always_on>1</always_on>
      <update_rate>1000.0</update_rate>
    </sensor>
  </gazebo>

  <gazebo reference="base_link">
    <sensor name="front_camera" type="camera">
      <pose>0.093 0.001 0.063 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <topic>front_camera/image_raw</topic>
      <camera name="intel_realsense_r200">
        <camera_info_topic>camera/camera_info</camera_info_topic>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Hydrodynamics plugin -->
    <plugin
      filename="gz-sim-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1000.0</water_density>
      <!-- Added mass: -->
      <xDotU>0</xDotU>
      <yDotV>0</yDotV>
      <zDotW>0</zDotW>
      <kDotP>0</kDotP>
      <mDotQ>0</mDotQ>
      <nDotR>0</nDotR>
      <!-- First order stability derivative: -->
      <xU>0</xU>
      <yV>0</yV>
      <zW>0</zW>
      <kP>0</kP>
      <mQ>0</mQ>
      <nR>0</nR>
      <!-- Second order stability derivative: -->
      <xUabsU>-58.42</xUabsU>
      <yVabsV>-55.137</yVabsV>
      <zWabsW>-124.818</zWabsW>
      <kPabsP>-4.0</kPabsP>
      <mQabsQ>-4.0</mQabsQ>
      <nRabsR>-4.0</nRabsR>
    </plugin>
  </gazebo>

  <link name="thruster1">
    <inertial>
      <origin />
      <mass value="0.002" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin rpy="-1.571 0 0" />
      <geometry>
        <mesh filename="package://bluerov2_gz/models/bluerov2_heavy/meshes/t200_ccw_prop.dae" />
      </geometry>
    </visual>
  </link>
  <link name="thruster2">
    <inertial>
      <origin />
      <mass value="0.002" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin rpy="-1.571 0 0" />
      <geometry>
        <mesh filename="package://bluerov2_gz/models/bluerov2_heavy/meshes/t200_ccw_prop.dae" />
      </geometry>
    </visual>
  </link>
  <link name="thruster3">
    <inertial>
      <origin />
      <mass value="0.002" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin rpy="1.571 0 0" />
      <geometry>
        <mesh filename="package://bluerov2_gz/models/bluerov2_heavy/meshes/t200_cw_prop.dae" />
      </geometry>
    </visual>
  </link>
  <link name="thruster4">
    <inertial>
      <origin />
      <mass value="0.002" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin rpy="1.571 0 0" />
      <geometry>
        <mesh filename="package://bluerov2_gz/models/bluerov2_heavy/meshes/t200_cw_prop.dae" />
      </geometry>
    </visual>
  </link>
  <link name="thruster5">
    <inertial>
      <origin />
      <mass value="0.002" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin rpy="-1.571 0 1.571" />
      <geometry>
        <mesh filename="package://bluerov2_gz/models/bluerov2_heavy/meshes/t200_ccw_prop.dae" />
      </geometry>
    </visual>
  </link>
  <link name="thruster6">
    <inertial>
      <origin />
      <mass value="0.002" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin rpy="1.571 0 1.571" />
      <geometry>
        <mesh filename="package://bluerov2_gz/models/bluerov2_heavy/meshes/t200_cw_prop.dae" />
      </geometry>
    </visual>
  </link>
  <link name="thruster7">
    <inertial>
      <origin />
      <mass value="0.002" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin rpy="1.571 0 1.571" />
      <geometry>
        <mesh filename="package://bluerov2_gz/models/bluerov2_heavy/meshes/t200_cw_prop.dae" />
      </geometry>
    </visual>
  </link>
  <link name="thruster8">
    <inertial>
      <origin />
      <mass value="0.002" />
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin rpy="-1.571 0 1.571" />
      <geometry>
        <mesh filename="package://bluerov2_gz/models/bluerov2_heavy/meshes/t200_ccw_prop.dae" />
      </geometry>
    </visual>
  </link>
  <joint name="thruster1_joint" type="continuous">
    <origin xyz="0.14 -0.092 0" rpy="-0.7860000104 1.570592654 0" />
    <parent link="base_link" />
    <child link="thruster1" />
    <axis xyz="0 0 -1" />
  </joint>
  <joint name="thruster2_joint" type="continuous">
    <origin xyz="0.14 0.092 0" rpy="0.7850000104 1.570592654 0" />
    <parent link="base_link" />
    <child link="thruster2" />
    <axis xyz="0 0 -1" />
  </joint>
  <joint name="thruster3_joint" type="continuous">
    <origin xyz="-0.14 -0.092 0" rpy="-2.35599999 1.570592654 0" />
    <parent link="base_link" />
    <child link="thruster3" />
    <axis xyz="0 0 -1" />
  </joint>
  <joint name="thruster4_joint" type="continuous">
    <origin xyz="-0.14 0.092 0" rpy="2.356185297 1.570592654 0" />
    <parent link="base_link" />
    <child link="thruster4" />
    <axis xyz="0 0 -1" />
  </joint>
  <joint name="thruster5_joint" type="continuous">
    <origin xyz="0.118 -0.215 0.064" />
    <parent link="base_link" />
    <child link="thruster5" />
    <axis xyz="0 0 -1" />
  </joint>
  <joint name="thruster6_joint" type="continuous">
    <origin xyz="0.118 0.215 0.064" />
    <parent link="base_link" />
    <child link="thruster6" />
    <axis xyz="0 0 -1" />
  </joint>
  <joint name="thruster7_joint" type="continuous">
    <origin xyz="-0.118 -0.215 0.064" />
    <parent link="base_link" />
    <child link="thruster7" />
    <axis xyz="0 0 -1" />
  </joint>
  <joint name="thruster8_joint" type="continuous">
    <origin xyz="-0.118 0.215 0.064" />
    <parent link="base_link" />
    <child link="thruster8" />
    <axis xyz="0 0 -1" />
  </joint>

  <gazebo>
    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>bluerov2_heavy</namespace>
      <joint_name>thruster1_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>bluerov2_heavy</namespace>
      <joint_name>thruster2_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>bluerov2_heavy</namespace>
      <joint_name>thruster3_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>bluerov2_heavy</namespace>
      <joint_name>thruster4_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>bluerov2_heavy</namespace>
      <joint_name>thruster5_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>bluerov2_heavy</namespace>
      <joint_name>thruster6_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>bluerov2_heavy</namespace>
      <joint_name>thruster7_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>bluerov2_heavy</namespace>
      <joint_name>thruster8_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin name="ArduPilotPlugin" filename="libArduPilotPlugin.so">
      <!-- Port settings -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Transform from the Gazebo body frame (x-forward, y-left, z-up)
           to the ArduPilot body frame (x-forward, y-right, z-down) -->
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.142 0 0</modelXYZToAirplaneXForwardZDown>

      <!-- Transform from the Gazebo world frame (ENU)
           to the ArduPilot world frame (NED) -->
      <gazeboXYZToNED>0 0 0 3.142 0 1.571</gazeboXYZToNED>

      <!-- Sensors -->
      <imuName>imu_sensor</imuName>

      <!-- Thrusters -->
      <control channel="0">
        <jointName>thruster1_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2_heavy/joint/thruster1_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="1">
        <jointName>thruster2_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2_heavy/joint/thruster2_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="2">
        <jointName>thruster3_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2_heavy/joint/thruster3_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="3">
        <jointName>thruster4_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2_heavy/joint/thruster4_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="4">
        <jointName>thruster5_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2_heavy/joint/thruster5_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="5">
        <jointName>thruster6_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2_heavy/joint/thruster6_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="6">
        <jointName>thruster7_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2_heavy/joint/thruster7_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      <control channel="7">
        <jointName>thruster8_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/bluerov2_heavy/joint/thruster8_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>

    </plugin>

  </gazebo>
</robot>